#compdef trk

autoload -U is-at-least

_trk() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_trk_commands" \
"*::: :->trk" \
&& ret=0
    case $state in
    (trk)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-w+[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--why=[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'--no-why[Do not ask for a why]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(then)
_arguments "${_arguments_options[@]}" : \
'-w+[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--why=[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-n[Wrap the current task instead of the most recently added one]' \
'--next[Wrap the current task instead of the most recently added one]' \
'--no-why[Do not ask for a why]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(and)
_arguments "${_arguments_options[@]}" : \
'-w+[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--why=[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'--no-why[Do not ask for a why]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(before)
_arguments "${_arguments_options[@]}" : \
'-w+[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--why=[Explain why this task exists (skips the prompt)]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'--no-why[Do not ask for a why]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(done)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-f[Finish even if the task has open sub-tasks]' \
'--force[Finish even if the task has open sub-tasks]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(time)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(drop)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-y[Skip the confirmation prompt when the task has sub-tasks]' \
'--yes[Skip the confirmation prompt when the task has sub-tasks]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(switch)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__switch_commands" \
"*::: :->switch" \
&& ret=0

    case $state in
    (switch)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-switch-command-$line[1]:"
        case $line[1] in
            (goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__list_commands" \
"*::: :->list" \
&& ret=0

    case $state in
    (list)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-list-command-$line[1]:"
        case $line[1] in
            (goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(undo)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'::count:_default' \
&& ret=0
;;
(new)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__new_commands" \
"*::: :->new" \
&& ret=0

    case $state in
    (new)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-new-command-$line[1]:"
        case $line[1] in
            (goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'*::title:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(progress)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__progress_commands" \
"*::: :->progress" \
&& ret=0

    case $state in
    (progress)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-progress-command-$line[1]:"
        case $line[1] in
            (goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__delete_commands" \
"*::: :->delete" \
&& ret=0

    case $state in
    (delete)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-delete-command-$line[1]:"
        case $line[1] in
            (goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-y[Skip the confirmation prompt]' \
'--yes[Skip the confirmation prompt]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(jot)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(inbox)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(log)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'*::when:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'::shell -- Install for this shell instead of auto-detecting:(sh bash zsh fish powershell elvish)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_trk_commands] )) ||
_trk_commands() {
    local commands; commands=(
'add:Add a task under the goal' \
'then:Add a task as a parent of the most recently added task' \
'and:Add a task as a sibling of the most recently added task' \
'before:Add a task as a sibling before the most recently added task' \
'done:Complete the current task' \
'time:Start timing the current task' \
'stop:Stop timing the current task' \
'drop:Delete a task, using the picker' \
'switch:Switch tasks using the picker' \
'list:Show the current task, its siblings, and its parents' \
'undo:Undo the last N changes' \
'new:Create a goal' \
'progress:Show the whole goal as a tree with progress' \
'delete:Delete a goal and every task under it' \
'jot:Capture a task in the inbox' \
'inbox:Open the inbox in the picker' \
'log:What got finished, by day' \
'completions:Install shell completions for the detected shell' \
    )
    _describe -t commands 'trk commands' commands "$@"
}
