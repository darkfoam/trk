&& ret=0
;;
        esac
    ;;
esac
;;
(prompt)
_arguments "${_arguments_options[@]}" : \
'--max=[]:MAX:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh fish powershell elvish)' \
&& ret=0
;;
        esac
    ;;
esac
