;;
        esac
    ;;
esac
;;
(log)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'*::when:_default' \
&& ret=0
;;
(at)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[]' \
'--switch[]' \
'--clear[Remove the schedule]' \
'-h[Print help]' \
'--help[Print help]' \
'*::when:_default' \
&& ret=0
;;
(agenda)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
