'--help[Print help]' \
'::count:_default' \
&& ret=0
;;
(goal)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__goal_commands" \
"*::: :->goal" \
&& ret=0

    case $state in
    (goal)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-goal-command-$line[1]:"
        case $line[1] in
            (show)
_arguments "${_arguments_options[@]}" : \
