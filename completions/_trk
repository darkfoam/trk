'-h[Print help]' \
'--help[Print help]' \
":: :_trk__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-config-command-$line[1]:"
        case $line[1] in
