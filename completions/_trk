(( $+functions[_trk_commands] )) ||
_trk_commands() {
    local commands; commands=(
'need:What am I doing, and why' \
'by:Goal by X\: a direct task under the active goal' \
'then:Once this is done, then X\: wrap the current chain in a new parent' \
'and:And X\: another task at the same level as the target' \
'done:Finish the current task and walk back up' \
'drop:Abandon the current task' \
'stop:Leave the current task unfinished, with a reason' \
'go:Resume the current task; show how I got here' \
'why:Chain of notes from the root to the current task' \
'note:Read or add note lines on a task' \
'rename:Change a task'\''s text' \
'switch:Switch to another task' \
'list:The whole task tree of the active goal' \
'undo:Undo the last N changes' \
'goal:Goals\: show, list, new, switch, done, rename, reopen' \
'jot:Quick capture to the inbox' \
'inbox:View the inbox, take or drop items' \
'log:What got finished, by day' \
'at:Schedule a task' \
'agenda:Scheduled tasks across all goals' \
'start:Live task list in a terminal pane' \
'config:Where the task list lives' \
'prompt:One short line for a shell prompt' \
'completions:Print shell completion script' \
    )
    _describe -t commands 'trk commands' commands "$@"
}
