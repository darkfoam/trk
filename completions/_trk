#compdef trk

autoload -U is-at-least

_trk() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_trk_commands" \
"*::: :->trk" \
&& ret=0
    case $state in
    (trk)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:trk-command-$line[1]:"
        case $line[1] in
            (need)
_arguments "${_arguments_options[@]}" : \
'-w+[Supply the why inline (skips the prompt)]:WHY:_default' \
'--why=[Supply the why inline (skips the prompt)]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[Switch to choose the target task instead of using the current task]' \
'--switch[Switch to choose the target task instead of using the current task]' \
'-n[Do not move the cursor onto the new task]' \
'--stay[Do not move the cursor onto the new task]' \
'--no-why[Do not ask for a why]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(by)
_arguments "${_arguments_options[@]}" : \
'-w+[]:WHY:_default' \
'--why=[]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'--no-why[]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(then)
_arguments "${_arguments_options[@]}" : \
'-w+[]:WHY:_default' \
'--why=[]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[]' \
'--switch[]' \
'--no-why[]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(and)
_arguments "${_arguments_options[@]}" : \
'-w+[]:WHY:_default' \
'--why=[]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[]' \
'--switch[]' \
'--no-why[]' \
'-h[Print help]' \
'--help[Print help]' \
'*::text:_default' \
&& ret=0
;;
(done)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-f[Finish even if the task has open sub-tasks]' \
'--force[Finish even if the task has open sub-tasks]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(drop)
_arguments "${_arguments_options[@]}" : \
'-w+[]:WHY:_default' \
'--why=[]:WHY:_default' \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-f[]' \
'--force[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[]' \
'--switch[]' \
'-h[Print help]' \
'--help[Print help]' \
'*::reason:_default' \
&& ret=0
;;
(go)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(why)
_arguments "${_arguments_options[@]}" : \
'--color=[When to colorize output]:COLOR:(auto always never)' \
'-s[]' \
'--switch[]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(note)
